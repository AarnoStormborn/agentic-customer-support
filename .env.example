# Agentic Customer Support — environment
# Copy to .env and fill in. Never commit .env.

# --- Agent model (pi SDK). Format: provider/model, e.g. "openai/gpt-5",
# "anthropic/claude-sonnet-4-5", "google/gemini-3-pro". Leave empty to let pi
# pick the first available model from ~/.pi/agent/auth.json.
PI_MODEL=

# --- Retrieval / SQL tool modes ---
# Integrated system: real Postgres (retrieval-core). Mock modes are for
# standalone track development only.
SQL_MODE=real
# Path (relative to repo root) to a module exporting getPool() (src/db/pool.ts).
# Use an absolute file:// URL if the tool is loaded from a bundled path.
SQL_IMPL=./src/db/pool.ts
# TAVILY_API_KEY unset -> duckduckgo fallback (see web-tool.ts)

# --- Postgres (pgvector) ---
# postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://acs:acs@localhost:5432/acs

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Web search ---
# Tavily preferred; falls back to DuckDuckGo when unset
TAVILY_API_KEY=

# --- Reranker (optional) ---
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# --- Server ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
