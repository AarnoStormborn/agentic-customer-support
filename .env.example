# Agentic Customer Support — environment
# Copy to .env and fill in. Never commit .env.

# --- Agent model (pi SDK). Format: provider/model, e.g. "openai/gpt-5",
# "anthropic/claude-sonnet-4-5", "google/gemini-3-pro". Leave empty to let pi
# pick the first available model from ~/.pi/agent/auth.json.
PI_MODEL=

# --- Postgres (pgvector) ---
# postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://acs:acs@localhost:5432/acs

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Web search ---
# Tavily preferred; falls back to DuckDuckGo when unset
TAVILY_API_KEY=

# --- Reranker (optional) ---
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# --- Server ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
