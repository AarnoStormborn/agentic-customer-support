{
  "name": "agentic-customer-support",
  "version": "2.0.0",
  "description": "Agentic customer support on the pi agents SDK — SQL + vector + web retrieval",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "spike": "tsx src/dev/spike.ts",
    "chat": "tsx src/cli/chat.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/retrieval/ingest.ts",
    "query": "tsx src/retrieval/query.ts",
    "mcp": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "ACS_TEST_DB=1 vitest run tests/retrieval.test.ts",
    "eval": "tsx src/eval/run.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sse": "^0.6.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^6.0.11",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.0",
    "fastify": "^5.11.3",
    "ioredis": "^6.0.0",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "typebox": "^1.3.12",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
